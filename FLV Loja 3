# =========================================================
# IDENTIFICAR PERÍODO
# =========================================================

def identificar_periodo(nome_arquivo):

    nome = os.path.basename(nome_arquivo)

    padrao = r"(\d+)a(\d+)-(\d+)"

    resultado = re.search(
        padrao,
        nome
    )

    if resultado:

        inicio = int(resultado.group(1))
        fim = int(resultado.group(2))
        mes = int(resultado.group(3))

        periodo = f"{inicio}a{fim}"

        nome_mes = MESES.get(
            mes,
            str(mes)
        )

        referencia = f"{nome_mes}<br>{periodo}"

        ordem = (
            mes * 100
            + inicio
        )

        return (
            nome_mes,
            periodo,
            referencia,
            ordem
        )

    return None, None, None, None

# =========================================================
# LEITURA CSV
# =========================================================

def ler_csv(arquivo):

    separadores = [
        ";",
        ",",
        "|",
        "\t"
    ]

    for sep in separadores:

        try:

            return pd.read_csv(
                arquivo,
                sep=sep,
                encoding="utf-8"
            )

        except:
            pass

    try:

        return pd.read_csv(
            arquivo,
            sep=None,
            engine="python",
            encoding="utf-8"
        )

    except:

        return pd.read_csv(
            arquivo,
            sep=None,
            engine="python",
            encoding="latin1"
        )

# =========================================================
# CONVERTER NÚMERO
# =========================================================

def converter_numero(valor):

    if pd.isna(valor):
        return None

    valor = str(valor).strip()

    if valor == "":
        return None

    valor = valor.replace("R$", "")
    valor = valor.replace("%", "")
    valor = valor.replace(" ", "")

    if "," in valor and "." in valor:

        if valor.rfind(",") > valor.rfind("."):

            valor = valor.replace(".", "")
            valor = valor.replace(",", ".")

        else:

            valor = valor.replace(",", "")

    elif "," in valor:

        valor = valor.replace(".", "")
        valor = valor.replace(",", ".")

    try:

        return float(valor)

    except:

        return None

# =========================================================
# FORMATAR NÚMERO
# =========================================================

def formatar_numero(valor):

    texto = f"{valor:,.2f}"

    texto = texto.replace(",", "X")
    texto = texto.replace(".", ",")
    texto = texto.replace("X", ".")

    return texto

# =========================================================
# PROCESSAR CSV
# =========================================================

def processar_csv(arquivo_csv):

    print(f"\nProcessando: {arquivo_csv}")

    (
        mes,
        periodo,
        referencia,
        ordem

    ) = identificar_periodo(
        arquivo_csv
    )

    if referencia is None:
        return None, None

    df_original = ler_csv(arquivo_csv)

    df = df_original.copy()

    df["MES"] = mes
    df["PERIODO"] = periodo
    df["REFERENCIA"] = referencia
    df["ORDEM"] = ordem

    ignorar = [
        "MES",
        "PERIODO",
        "REFERENCIA",
        "ORDEM"
    ]

    colunas_numericas = []

    for col in df.columns:

        if col in ignorar:
            continue

        try:

            if col != "Nm.Produto":

                df[col] = df[col].apply(
                    converter_numero
                )

                if df[col].notna().sum() > 0:
                    colunas_numericas.append(col)

        except:
            pass

    agrupado = (

        df.groupby(
            [
                "MES",
                "PERIODO",
                "REFERENCIA",
                "ORDEM"
            ]
        )[colunas_numericas]

        .sum()

        .reset_index()

    )

    return agrupado, df_original

# =========================================================
# GERAR TOP 5
# =========================================================

def gerar_top5(

    dashboard,
    df,
    coluna,
    cor,
    row,
    col,
    moeda=False

):

    if coluna is None:
        return

    if coluna not in df.columns:
        return

    top5 = (

        df.groupby("Nm.Produto")[coluna]

        .sum()

        .sort_values(ascending=False)

        .head(5)

        .sort_values()

    )

    if top5.empty:
        return

    nomes_produtos = []
    valores_formatados = []

    for produto in top5.index:

        nome = str(produto)

        if len(nome) > 28:
            nome = nome[:28] + "..."

        if not moeda:
            nome = f"{nome} KG"

        nomes_produtos.append(nome)

    for valor in top5.values:

        if moeda:

            valores_formatados.append(
                f"<b>R$ {formatar_numero(valor)}</b>"
            )

        else:

            valores_formatados.append(
                f"<b>{formatar_numero(valor)} KG</b>"
            )

    posicoes = [0, 1, 2, 3, 4]

    dashboard.add_trace(

        go.Bar(

            x=top5.values,

            y=posicoes,

            orientation="h",

            text=nomes_produtos,

            textposition="inside",

            insidetextanchor="start",

            textfont=dict(
                size=30,
                color="white"
            ),

            marker=dict(
                color=cor
            ),

            cliponaxis=False,

            hovertemplate="%{text}<br>%{x:.2f}<extra></extra>",

            showlegend=False

        ),

        row=row,
        col=col

    )

    dashboard.add_trace(

        go.Scatter(

            x=top5.values,

            y=posicoes,

            mode="text",

            text=valores_formatados,

            textposition="middle right",

            textfont=dict(
                size=18,
                color="white"
            ),

            showlegend=False,

            hoverinfo="skip"

        ),

        row=row,
        col=col

    )

    maior_valor = top5.max()

    dashboard.update_xaxes(

        range=[
            0,
            maior_valor * 1.35
        ],

        row=row,
        col=col

    )

    dashboard.update_yaxes(

        showticklabels=False,
        showgrid=True,
        zeroline=False,

        row=row,
        col=col

    )

