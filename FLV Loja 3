                    quebra_total,
                    desvio_total
                ],

                text=[

                    (
                        f"{quebra_total:.1f}"
                        .replace(".", ",")
                        .replace(",0", "")
                        + "%"
                    ),

                    (
                        f"{desvio_total:.1f}"
                        .replace(".", ",")
                        .replace(",0", "")
                        + "%"
                    )

                ],

                textinfo="label+text",

                hole=0.45,

                textposition="inside",

                insidetextorientation="radial",

                textfont=dict(
                    size=18,
                    color="white"
                ),

                marker=dict(

                    colors=[
                        "#FF4500",
                        "#8A2BE2"
                    ]

                ),

                title=dict(

                    text=mes,

                    position="top center",

                    font=dict(
                        size=22,
                        color="white"
                    )

                ),

                showlegend=False,

                hoverinfo="label+percent",

                name=""

            ),

            row=9,
            col=1

        )

    # =====================================================
    # POSICIONAR PIZZAS
    # =====================================================

    pizzas = [

        trace for trace in dashboard.data

        if trace.type == "pie"

    ]

    for i, trace in enumerate(pizzas):

        inicio = i * largura
        fim = inicio + largura

        trace.domain = dict(

            x=[
                inicio + 0.01,
                fim - 0.01
            ],

            y=[
                0.08,
                0.46
            ]

        )

    # =====================================================
    # LAYOUT
    # =====================================================

    dashboard.update_layout(

        margin=dict(
            t=250,
            b=40
        ),

        barmode="stack",

        template="plotly_dark",

        paper_bgcolor="#050816",

        plot_bgcolor="#050816",

        font=dict(
            family="Arial",
            size=14,
            color="white"
        ),

        title=dict(

            text=(
                f"FLV Loja 3"
                f" &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; "
                f"<span style='font-size:35px;'>"
                f"Última atualização: {DATA_ATUALIZACAO}"
                f"</span>"
            ),

            x=0.5,
            y=0.985,

            font=dict(
                size=115,
                color="#079534"
            )

        ),

        hovermode="x unified",

        height=4300,

        showlegend=True,

        legend=dict(

            orientation="h",

            yanchor="top",
            y=1.02,

            xanchor="right",
            x=1,

            font=dict(
                size=18,
                color="white"
            ),

            bgcolor="rgba(0,0,0,0)",

            bordercolor="#00F5FF",

            borderwidth=1

        )

    )
    # =====================================================
    # EIXOS
    # =====================================================

    for linha in range(1, 9):

        for coluna in [1, 2]:

            try:

                dashboard.update_xaxes(

                    showgrid=False,

                    row=linha,
                    col=coluna

                )

                dashboard.update_yaxes(

                    showgrid=True,
                    gridcolor="rgba(255,255,255,0.08)",

                    row=linha,
                    col=coluna

                )

            except:
                pass

    # =====================================================
    # SALVAR
    # =====================================================

    caminho_dashboard = os.path.join(
        PASTA_SAIDA,
        ARQUIVO_FINAL
    )

    dashboard.write_html(
        caminho_dashboard,
        include_plotlyjs="cdn"
    )

    print("\n================================================")
    print("DASHBOARD GERADO COM SUCESSO")
    print("================================================")

    print(f"\nÚltima atualização: {DATA_ATUALIZACAO}")

    print(f"\nArquivo gerado:")
    print(caminho_dashboard)

